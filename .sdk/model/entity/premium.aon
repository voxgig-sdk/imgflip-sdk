# Entity: premium

main: kit: entity: premium: {

  alias: field: {}

  fields: [
    {
      name: "meme"
      req: false
      type: "`$ANY`"
    }
    {
      name: "memes"
      req: false
      type: "`$ARRAY`"
    }
  ]

  name: "premium"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/ai_meme"
          segments: [
            {
              lit: "ai_meme"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/automeme"
          segments: [
            {
              lit: "automeme"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/caption_gif"
          segments: [
            {
              lit: "caption_gif"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/get_meme"
          segments: [
            {
              lit: "get_meme"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "POST"
          orig: "/search_memes"
          segments: [
            {
              lit: "search_memes"
            }
          ]
          transform: {
